#!/usr/bin/env python3
"""Speak text, writing the audio and the time each word is spoken.

    rec-tts --engine edge|deepgram|gemini --voice V --rate R --text T --mp3 OUT.mp3 --words OUT.words.json

edge      Microsoft Edge neural voices; word times from its word boundaries.
          Needs the edge_tts module: rec-step runs this with the Python
          beside the edge-tts command.
deepgram  Deepgram Aura-2 (--voice aura-2-thalia-en, ...); Aura gives no word
          times, so the audio is transcribed again with Nova-3 for them.
          Needs DEEPGRAM_API_KEY. Standard library only.
gemini    Gemini TTS (--voice Sulafat, Achird, Kore, …; --style "Say warmly, like …:";
          --lang hi for Hindi). Needs GEMINI_API_KEY, and DEEPGRAM_API_KEY for the
          word times; ffmpeg or Docker to make the MP3. Waits out per-minute quotas.

The word file is a list of {w, start, end} in seconds, one entry per word of
the TEXT (punctuation kept), which rec-animate cues against.
"""
import argparse, asyncio, difflib, json, os, re, sys, urllib.request

norm = lambda s: re.sub(r"[^a-z0-9]", "", s.lower())


def attach_punctuation(words, text):
    """Boundaries come without punctuation; take it back from the text."""
    pos = 0
    for w in words:
        i = text.find(w["w"], pos)
        if i < 0:
            continue
        pos = i + len(w["w"])
        while pos < len(text) and text[pos] in ".,!?:;।":
            w["w"] += text[pos]
            pos += 1
    return words


def align(text, heard):
    """Give each word of the text the time of the heard word it matches.

    heard: [{w, start, end}] from a transcript. Words the transcript spelled
    differently ("1000" for "thousand") get times spread between neighbours.
    """
    script = text.split()
    a, b = [norm(w) for w in script], [norm(h["w"]) for h in heard]
    times = [None] * len(script)
    for i, j, n in difflib.SequenceMatcher(None, a, b, autojunk=False).get_matching_blocks():
        for k in range(n):
            times[i + k] = (heard[j + k]["start"], heard[j + k]["end"])
    end = heard[-1]["end"] if heard else 1.0
    k = 0
    while k < len(script):
        if times[k] is not None:
            k += 1
            continue
        g = k
        while g < len(script) and times[g] is None:
            g += 1
        lo = times[k - 1][1] if k > 0 else 0.0
        hi = times[g][0] if g < len(script) else end
        step = max(hi - lo, 0.05) / (g - k)
        for m in range(k, g):
            times[m] = (lo + step * (m - k), lo + step * (m - k + 1) - 0.02)
        k = g
    return [{"w": w, "start": round(s, 3), "end": round(e, 3)} for w, (s, e) in zip(script, times)]


async def edge(a):
    import edge_tts
    words, audio = [], bytearray()
    comm = edge_tts.Communicate(a.text, a.voice, rate=a.rate, boundary="WordBoundary")
    async for chunk in comm.stream():
        if chunk["type"] == "audio":
            audio += chunk["data"]
        elif chunk["type"] == "WordBoundary":
            start = chunk["offset"] / 1e7  # 100 ns ticks
            words.append({"w": chunk["text"], "start": round(start, 3),
                          "end": round(start + chunk["duration"] / 1e7, 3)})
    return bytes(audio), attach_punctuation(words, a.text)


def http(url, body, headers, tries=8):
    """POST with retries: per-minute quotas (429) and brief outages (5xx) wait and try again."""
    import time, urllib.error
    for n in range(tries):
        try:
            req = urllib.request.Request(url, data=body, headers=headers)
            with urllib.request.urlopen(req, timeout=180) as r:
                return r.read()
        except urllib.error.HTTPError as e:
            if e.code not in (429, 500, 502, 503, 504) or n == tries - 1:
                sys.exit(f"rec-tts: {url.split('?')[0]}: HTTP {e.code} {e.read()[:200]!r}")
            time.sleep(min(60, 8 * (n + 1)))
        except (urllib.error.URLError, TimeoutError, ConnectionError, OSError) as e:  # timeouts, dropped connections
            if n == tries - 1:
                sys.exit(f"rec-tts: {url.split('?')[0]}: {e}")
            time.sleep(min(60, 8 * (n + 1)))


def transcribe(audio, ctype, lang):
    """Word times by transcribing the audio with Deepgram Nova-3."""
    key = os.environ.get("DEEPGRAM_API_KEY")
    if not key:
        sys.exit("rec-tts: DEEPGRAM_API_KEY is not set (needed for word times)")
    language = "en" if lang.startswith("en") else "multi"
    res = json.loads(http(f"https://api.deepgram.com/v1/listen?model=nova-3&language={language}&punctuate=false",
                          audio, {"Authorization": f"Token {key}", "Content-Type": ctype}))
    return [{"w": w["word"], "start": w["start"], "end": w["end"]}
            for w in res["results"]["channels"][0]["alternatives"][0]["words"]]


def deepgram(a):
    key = os.environ.get("DEEPGRAM_API_KEY")
    if not key:
        sys.exit("rec-tts: DEEPGRAM_API_KEY is not set")
    audio = http(f"https://api.deepgram.com/v1/speak?model={a.voice}&encoding=mp3",
                 json.dumps({"text": a.text}).encode(), {"Authorization": f"Token {key}", "Content-Type": "application/json"})
    return audio, align(a.text, transcribe(audio, "audio/mpeg", a.lang))


def to_mp3(wav):
    """WAV bytes to MP3 with ffmpeg, installed or in Docker."""
    import shutil, subprocess, tempfile
    with tempfile.TemporaryDirectory() as d:
        src, dst = os.path.join(d, "in.wav"), os.path.join(d, "out.mp3")
        open(src, "wb").write(wav)
        if shutil.which("ffmpeg"):
            cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-y", "-i", src, "-b:a", "128k", dst]
        else:
            cmd = ["docker", "run", "--rm", "-u", f"{os.getuid()}:{os.getgid()}", "-v", f"{d}:{d}",
                   os.environ.get("REC_FFMPEG_IMAGE", "jrottenberg/ffmpeg:6.1-alpine"),
                   "-hide_banner", "-loglevel", "error", "-y", "-i", src, "-b:a", "128k", dst]
        subprocess.run(cmd, check=True)
        return open(dst, "rb").read()


def gemini(a):
    """Gemini TTS (Google AI Studio key). --style is a direction placed before the text
    ("Say warmly, like …:"), which gemini-2.5-pro-preview-tts follows without reading aloud;
    the newest TTS model reads any direction out, so it is not the default."""
    import base64, io, wave
    key = os.environ.get("GEMINI_API_KEY")
    if not key:
        sys.exit("rec-tts: GEMINI_API_KEY is not set")
    model = a.model or "gemini-2.5-pro-preview-tts"
    prompt = f"{a.style} {a.text}" if a.style else a.text
    body = {"contents": [{"parts": [{"text": prompt}]}],
            "generationConfig": {"responseModalities": ["AUDIO"],
                                 "speechConfig": {"voiceConfig": {"prebuiltVoiceConfig": {"voiceName": a.voice}}}}}
    if a.wav:  # audio made elsewhere (a batch job): only transcribe, align and encode it
        part = {"mimeType": "audio/wav", "data": base64.b64encode(open(a.wav, "rb").read()).decode()}
    else:
        for attempt in range(4):  # the model now and then answers with no audio: ask again
            res = json.loads(http(f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent",
                                  json.dumps(body).encode(), {"Content-Type": "application/json", "x-goog-api-key": key}))
            parts = res.get("candidates", [{}])[0].get("content", {}).get("parts", [])
            part = next((p["inlineData"] for p in parts if "inlineData" in p), None)
            if part:
                break
        else:
            sys.exit("rec-tts: gemini returned no audio four times")
    raw = base64.b64decode(part["data"])
    if not part["mimeType"].startswith("audio/wav"):  # raw 16-bit PCM
        rate = int(part["mimeType"].split("rate=")[1].split(";")[0]) if "rate=" in part["mimeType"] else 24000
        buf = io.BytesIO()
        with wave.open(buf, "wb") as w:
            w.setnchannels(1); w.setsampwidth(2); w.setframerate(rate); w.writeframes(raw)
        raw = buf.getvalue()
    heard = transcribe(raw, "audio/wav", a.lang)
    if heard and " ".join(h["w"] for h in heard[:2]).lower().startswith("say"):
        sys.exit("rec-tts: the model spoke the style direction aloud; use another model or drop --style")
    return to_mp3(raw), align(a.text, heard)


p = argparse.ArgumentParser()
p.add_argument("--engine", default="edge", choices=["edge", "deepgram", "gemini"])
for k in ("voice", "rate", "text", "mp3", "words"):
    p.add_argument("--" + k, required=True)
p.add_argument("--style", default="", help="gemini: how to speak, e.g. 'Say warmly, like a teacher:'")
p.add_argument("--model", default="", help="gemini: TTS model (default gemini-2.5-pro-preview-tts)")
p.add_argument("--lang", default="en", help="language of the text, for the transcript that gives word times")
p.add_argument("--wav", default="", help="gemini: use this audio (e.g. from a batch job) instead of generating it")
args = p.parse_args()
audio, words = asyncio.run(edge(args)) if args.engine == "edge" else deepgram(args) if args.engine == "deepgram" else gemini(args)
open(args.mp3, "wb").write(audio)
json.dump(words, open(args.words, "w"), indent=1)
